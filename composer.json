{
    "name": "laravel-enso/enso",
    "type": "project",
    "description": "Laravel Enso can be a solid start for any SPA based on Laravel 13.x, Vue 3.5, Vite and Bulma",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel-enso/calendar": "^3.5",
        "laravel-enso/comments": "^4.6",
        "laravel-enso/core": "^12.2",
        "laravel-enso/data-import": "^6.10",
        "laravel-enso/documents": "^5.0",
        "laravel-enso/excel": "^3.0",
        "laravel-enso/helpers": "^4.0",
        "laravel-enso/how-to": "^5.5",
        "laravel-enso/pdf": "^2.0",
        "laravel-enso/tasks": "^2.5",
        "laravel-enso/tutorials": "^5.4",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.0",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.0",
        "sentry/sentry-laravel": "^4.25",
        "symfony/http-client": "^7.0",
        "fakerphp/faker": "^1.9.1",
        "symfony/mailgun-mailer": "^7.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "brianium/paratest": "^7.4",
        "filp/whoops": "^2.18.4",
        "laravel-enso/cli": "^5.5",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.9.4",
        "nunomaduro/phpinsights": "^2.13",
        "phpunit/phpunit": "^11.5.50"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "LaravelEnso\\Tables\\Tests\\": "vendor/laravel-enso/tables/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "php artisan enso:localisation:scan",
            "php artisan telescope:publish",
            "php artisan horizon:publish",
            "php artisan enso:upgrade:status"
        ]
    }
}